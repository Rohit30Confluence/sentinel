# Sentinel AI Configuration

# Server Port
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS in development)
CLIENT_URL=http://localhost:5173

# AI Provider API Keys (Optional on server if users supply keys via UI Settings Modal)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Active Model & Fallback
# Options: "mock", "gemini-2.5-flash", "gemini-1.5-pro", "gpt-4o", "gpt-4o-mini", "claude-3-7-sonnet"
DEFAULT_MODEL=mock

# Local Storage Database Path
DATABASE_PATH=./data/sentinel.db
